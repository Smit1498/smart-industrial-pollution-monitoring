# ─── IBM watsonx.ai / Granite ──────────────────────────────────────────────
IBM_CLOUD_API_KEY=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-13b-instruct-v2
IBM_PROJECT_ID=

# ─── App ────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
RESOURCE_MODE=NORMAL

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./pollution_monitor.db

# ─── Monitoring ─────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
STALE_DATA_THRESHOLD_SECONDS=300
SENSOR_FREEZE_WINDOW=10

# ─── ML ─────────────────────────────────────────────────────────────────────
ANOMALY_ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05
ROLLING_WINDOW_SIZE=60

# ─── Risk ────────────────────────────────────────────────────────────────────
RISK_LOW_MAX=20
RISK_MODERATE_MAX=40
RISK_ELEVATED_MAX=60
RISK_HIGH_MAX=80

# ─── Granite trigger ─────────────────────────────────────────────────────────
GRANITE_TRIGGER_RISK_SCORE=41
GRANITE_MAX_CONTEXT_TOKENS=2000
GRANITE_TIMEOUT_SECONDS=30

# ─── Alerts — Email (optional) ───────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_RECIPIENTS=

# ─── Alerts — Webhook (optional, Slack/Teams/custom) ────────────────────────
ALERT_WEBHOOK_URL=

# ─── MQTT (optional) ────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=pollution/sensors
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Industrial zones (comma-separated) ─────────────────────────────────────
INDUSTRIAL_ZONES=["Vapi", "Ankleshwar", "Vatva", "Naroda", "Odhav"]
